# Copy to .env (which is git-ignored) or export these in your shell / MCP client config.
# Your own LPDB API key from https://liquipedia.net/api - never commit it, never share it.
LIQUIPEDIA_API_KEY=
# Identify YOUR project and a way to contact you, e.g. "my-esports-bot/1.0 (https://github.com/you/my-esports-bot; you@example.org)"
LIQUIPEDIA_USER_AGENT=
# Optional: lower the per-process request budget (max and default: 60 per hour)
# LIQUIPEDIA_MAX_REQUESTS_PER_HOUR=60
# Optional: how long to stop sending requests after an HTTP 429 (seconds, default 600, minimum 60)
# LIQUIPEDIA_LOCKOUT_SECONDS=600
